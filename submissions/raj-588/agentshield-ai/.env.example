# AgentShield AI — environment configuration (copy to .env)
APP_NAME="AgentShield AI — IntentLock"
ENVIRONMENT=development
DEMO_MODE=true

# Persistence (SQLite for MVP; swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./agentshield.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agentshield

# ---- LLM provider ----
# Choose one: ollama (local) | openai (OpenAI-compatible) | anthropic
# "openai" also covers Azure OpenAI and most internal/corporate proxies that
# speak the OpenAI /chat/completions schema.
LLM_PROVIDER=ollama

# Hosted-provider settings (leave blank when using Ollama)
LLM_API_KEY=
# Optional base-url override:
#   OpenAI:    https://api.openai.com/v1   (default if blank)
#   Azure/proxy: https://<your-host>/v1
#   Anthropic: https://api.anthropic.com   (default if blank)
LLM_BASE_URL=
# Optional model override, e.g. gpt-4o-mini  or  claude-3-5-sonnet-latest
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Ollama (local), used only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30

# Set true to force the deterministic mock agent regardless of provider
FORCE_MOCK_AGENT=false

# Fixed synthetic trusted identity (DEV ONLY — replace with real authn in prod)
DEMO_USER_ID=user-demo-001
AGENT_ID=agent-intentlock-001

# Limits
MAX_REQUEST_BYTES=256000
DEFAULT_TASK_TTL_MINUTES=60
