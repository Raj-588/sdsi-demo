  "regex_signatures": [
    {
      "id": "rx_0001",
      "pattern": "(?i)\\b(ignore|disregard|forget|override)\\b.{0,40}\\b(previous|prior|above|earlier|all|system)\\b.{0,20}\\b(instructions?|rules?|prompts?|guidelines?|directives?)\\b",
      "category": "INSTRUCTION_OVERRIDE",
      "severity": "CRITICAL"
    },
    {
      "id": "rx_0002",
      "pattern": "(?i)\\b(reveal|print|show|output|leak)\\b.{0,30}\\b(system|hidden|initial)\\s+(prompt|instructions?)\\b",
      "category": "SYSTEM_PROMPT_EXTRACTION",
      "severity": "HIGH"
    },
    {
      "id": "rx_0003",
      "pattern": "(?i)\\bcurl\\b[^\\n]{0,200}(\\.ssh|\\.env|id_rsa|aws/credentials|token|secret)",
      "category": "TOOL_HIJACK",
      "severity": "CRITICAL"
    },
    {
      "id": "rx_0004",
      "pattern": "(?i)!\\[[^\\]]*\\]\\(https?://[^)]*\\?[^)]*(data|q|secret|token|key)=",
      "category": "DATA_EXFILTRATION",
      "severity": "HIGH"
    },
    {
      "id": "rx_0005",
      "pattern": "(?i)<\\s*/?\\s*(system|im_start|im_end)\\s*>|\\[/?INST\\]",
      "category": "ROLE_OVERRIDE",
      "severity": "HIGH"
    },
    {
      "id": "rx_ko_001",
