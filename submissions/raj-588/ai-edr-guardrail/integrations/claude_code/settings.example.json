      { "hooks": [ { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/integrations/claude_code/ai_edr_hook.py", "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Bash|Write|Edit|mcp__.*",
